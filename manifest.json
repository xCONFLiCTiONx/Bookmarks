{
  "manifest_version": 3,
  "name": "Bookmarks Manager",
  "version": "1.0",
  "description": "Clean dark-themed bookmark manager with custom home page, modal folders, usage tracking, and options page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "home.html"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "bookmarks",
    "unlimitedStorage",
    "storage",
    "history"
  ]
}