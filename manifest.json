{
  "manifest_version": 3,
  "name": "Bookmarks",
  "version": "1.0",
  "description": "Clean dark-themed bookmark manager with custom home page, modal folders, usage tracking, and options page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "home.html"
  },
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "bookmarks",
    "unlimitedStorage",
    "storage",
    "history",
    "windows"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}